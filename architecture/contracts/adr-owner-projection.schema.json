{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-architecture/blob/main/architecture/contracts/adr-owner-projection.schema.json",
  "title": "Immutable external ADR owner projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "purpose", "owner", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "repositoryId", "sourceCommit"],
      "properties": {
        "repository": { "const": "agentic-delivery-lab/agentic-delivery" },
        "repositoryId": { "const": 1358455028 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonicalPath", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
          "canonicalPath": { "type": "string", "pattern": "^docs/decisions/[0-9]{4}-[a-z0-9-]+\\.md$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
