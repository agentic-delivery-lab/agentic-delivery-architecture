{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-architecture/blob/main/architecture/contracts/architecture-release.schema.json",
  "title": "Architecture release manifest schemaVersion 1",
  "description": "The manifest structure uses schemaVersion 1. Digest semantics are versioned independently by contractVersions.architectureRelease, currently 2.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "architectureId",
    "version",
    "sourceRepository",
    "sourceCommit",
    "contentSha256",
    "status",
    "principleIds",
    "adrIds",
    "contextIds",
    "conformancePolicy",
    "toolingLock",
    "contractVersions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "architectureId": { "type": "string", "pattern": "^urn:agentic-delivery:architecture:[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "sourceRepository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "For architectureRelease contract 2.0.0, this is the immutable prepared source commit whose normalized Architecture tree must reproduce contentSha256."
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "For architectureRelease contract 2.0.0, SHA-256 over authoritative Architecture files after normalizing only sourceCommit and contentSha256 in this manifest."
    },
    "status": { "enum": ["draft", "released", "withdrawn"] },
    "principleIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^AP-[0-9]{3}$" } },
    "adrIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^urn:agentic-delivery:adr:[a-z0-9-]+:[0-9]{4}$" } },
    "contextIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "conformancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\s]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "toolingLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\s]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contractVersions": {
      "type": "object",
      "required": ["architectureRelease"],
      "properties": {
        "architectureRelease": {
          "const": "2.0.0",
          "description": "Contract 2.0.0 uses the prepared-source-commit digest algorithm defined for this manifest."
        }
      },
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    }
  }
}
