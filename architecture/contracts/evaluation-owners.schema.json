{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-delivery-lab.github.io/architecture/contracts/evaluation-owners.schema.json",
  "title": "Offline evaluation finding ownership v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "mappings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "const": "offline-proposal-only"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "subjectId",
          "subjectSource",
          "owner",
          "sourceIssue",
          "rationale"
        ],
        "properties": {
          "layer": {
            "enum": [
              "agent-capability",
              "factory",
              "product-outcome"
            ]
          },
          "subjectId": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "subjectSource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "repositoryId",
              "path"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "repositoryId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "path": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              }
            }
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "repositoryId"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "repositoryId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "sourceIssue": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"
          },
          "rationale": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
