{
  "type": "object",
  "properties": {
    "architectureId": {
      "type": "string"
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "adrs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(ADR|ADP|ADD)-[0-9]{4}$"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "agentic-delivery-governance",
                "agentic-delivery-control-plane",
                "agentic-primitives",
                "developer-distribution"
              ]
            }
          },
          "enforcement": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sourcePath": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "adrs",
          "domains",
          "enforcement",
          "id",
          "kind",
          "sourcePath",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "releaseId": {
          "type": "string"
        },
        "releaseVersion": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "minLength": 40,
          "maxLength": 40
        },
        "status": {
          "enum": [
            "draft",
            "released",
            "withdrawn"
          ]
        },
        "repositoryId": {
          "type": "integer",
          "const": 1380894656
        }
      },
      "required": [
        "contentSha256",
        "releaseId",
        "releaseVersion",
        "repository",
        "sourceCommit",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "architectureId",
    "primitives",
    "schemaVersion",
    "source"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-delivery-lab.github.io/architecture/contracts/primitive-catalog-lock.schema.json",
  "title": "primitive-catalog-lock",
  "description": "Closed catalog-source contracts: historical schema 1 keeps its original repository locator without a native ID; schema 2 binds the current Customizations locator to native repository ID 1380894656. Both retain immutable source/digest metadata. This declaration does not replace live hosting or release admission.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "repository": {
                "const": "agentic-delivery-lab/agentic-delivery-primitives"
              },
              "repositoryId": {
                "type": "integer",
                "const": 1380894656
              }
            },
            "not": {
              "required": [
                "repositoryId"
              ],
              "type": "object",
              "properties": {
                "repositoryId": {}
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "repository": {
                "const": "agentic-delivery-lab/agentic-delivery-agent-customizations"
              },
              "repositoryId": {
                "type": "integer",
                "const": 1380894656
              }
            },
            "required": [
              "repositoryId"
            ],
            "type": "object"
          }
        }
      }
    }
  ]
}
