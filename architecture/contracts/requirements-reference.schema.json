{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-delivery-lab.github.io/architecture/contracts/requirements-reference.schema.json",
  "title": "Selected immutable Requirements baseline reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "repositoryId",
    "commit",
    "manifestPath",
    "contentSha256",
    "version",
    "qrIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "const": "agentic-delivery-lab/agentic-delivery-requirements"
    },
    "repositoryId": {
      "const": 1416207421
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifestPath": {
      "const": "manifests/requirements-release.json"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "qrIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^QR-[0-9]{3}$"
      }
    }
  }
}
