flowchart TD
  STATUS["Configuration readback 2026-10-21: private portfolio 2 has two saved value-stream filters and 19 factory source-Issue items; 0 product items.<br/>App access, runtime planning context and end-to-end delivery remain unproved. The flow below is an authorization contract.<br/>Dated evidence: system-evidence.yml#portfolio-owner-delegated-configuration-20261021"]
  PROJECT["GitHub Projects<br/>item membership, portfolio planning, and progress visibility"]
  CARD["Project-only card"]
  HUMAN["Maintainer creates or links an Issue"]
  ISSUE["Source Issue in the owning repository"]
  EVENT["Eligible Issue event"]
  APP["GitHub App installation<br/>signed event and selected repository access"]
  INGRESS["Vercel webhook ingress<br/>signature, delivery ID, and bounded dispatch"]
  CONTROL["Agentic Delivery Control Plane"]
  IDENTITY["Deterministic origin identity and actor permission"]
  CONTRACT["Issue Type, lifecycle, field, dependency, and policy checks"]
  HOLD["Hold without mutation"]
  WRITER["One bounded authorized writer"]
  ACTIONS["GitHub Actions<br/>trusted intake and runner"]
  CODEX["Pinned Codex CLI<br/>repository-scoped workspace"]
  PR["Issue-linked pull request"]
  REVIEW["Independent validation and evaluation"]
  MERGE["Human review and merge decision"]
  EVIDENCE["Provenance and product or factory outcome evidence"]
  PROGRESS["Project progress projection<br/>planning visibility only"]
  FINDING["Finding becomes an owner Issue"]
  LOOP["People prioritize in Projects before next authorization"]

  CARD -->|"planning input only"| PROJECT
  PROJECT -->|"must link or convert before execution"| HUMAN
  HUMAN --> ISSUE
  ISSUE -->|"Project item membership for planning; not authorization"| PROJECT
  PROJECT -. "never an execution trigger" .-> IDENTITY
  ISSUE --> EVENT --> APP --> INGRESS --> CONTROL --> IDENTITY --> CONTRACT
  IDENTITY -->|"identity or permission fails"| HOLD
  CONTRACT -->|"unknown or invalid"| HOLD
  CONTRACT -->|"all gates pass"| ACTIONS --> CODEX --> WRITER --> PR --> REVIEW --> MERGE --> EVIDENCE
  EVIDENCE --> PROGRESS --> PROJECT
  EVIDENCE --> FINDING --> LOOP --> ISSUE

  subgraph REPLAY["Separate state owners"]
    WEBHOOK["Webhook delivery replay<br/>event-processing state"]
    SESSION["Codex session continuation<br/>one bounded runner operation"]
    EVALUATION["Evaluation replay<br/>versioned dataset and grader"]
  end
  STATUS -.-> PROJECT
  STATUS -.-> CONTROL
